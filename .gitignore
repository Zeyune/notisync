# IDE
.idea/
.vscode/

# OS
Thumbs.db
.DS_Store

# Throwaway M2 development pairing key — never a real secret, never committed.
tools/peer-session.json

# Relay (M3)
relay/node_modules/
# Local miniflare/D1 state — a SQLite database holding real device secrets and
# ciphertext from local testing. Regenerated by `wrangler dev`.
relay/.wrangler/

# Credentials that must never reach a public remote.
# The FCM service-account key can push to every device this app has registered;
# google-services.json identifies the Firebase project to the app.
**/google-services.json
**/service-account*.json
